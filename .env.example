# Browser-exposed Supabase values for the planned production backend.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Keep local until the Supabase-backed stores are implemented.
REACT_APP_PERSISTENCE_MODE=local

# Server-only. Add this in Vercel Project Settings, not in browser-exposed vars.
ANTHROPIC_API_KEY=
