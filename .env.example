# Browser switch. Use local for single-browser development, remote for shared beta testing.
REACT_APP_PERSISTENCE_MODE=local

# Server-side persistent storage. Set these in Vercel Project Settings for remote mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only commercial onboarding controls (32+ random bytes for the fingerprint secret).
COMMERCIAL_ONBOARDING_FINGERPRINT_SECRET=
COMMERCIAL_ONBOARDING_APP_ORIGIN=https://your-production-domain.example
# Set only to an IP header overwritten by the trusted deployment proxy (Vercel: x-forwarded-for).
COMMERCIAL_ONBOARDING_TRUSTED_IP_HEADER=x-forwarded-for
# Spray Command invitation acceptance window only; independent of the provider's
# separately time-limited email security link. Bounded to 300–86400 seconds.
COMMERCIAL_ONBOARDING_ACCEPTANCE_WINDOW_SECONDS=3600

# Server-only. Add this in Vercel Project Settings, not in browser-exposed vars.
ANTHROPIC_API_KEY=
