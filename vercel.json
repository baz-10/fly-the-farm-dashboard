{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "CI=false npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "functions": {
    "api/auth.js": {
      "maxDuration": 15
    },
    "api/identify-weed.js": {
      "maxDuration": 30
    },
    "api/pmav.js": {
      "maxDuration": 30
    },
    "api/store.js": {
      "maxDuration": 15
    },
    "api/v1/[resource].js": {
      "maxDuration": 15
    },
    "api/report-worker.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
